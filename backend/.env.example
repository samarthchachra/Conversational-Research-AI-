# backend/.env.example
# Production API environment variables
# Copy to backend/.env for local development. NEVER commit the real .env.

# Mistral LLM (required)
MISTRAL_API_KEY=your-mistral-api-key

# Cohere Rerank API (required) — get free key at https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-api-key

# Qdrant vector store (required)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# PostgreSQL (required)
POSTGRES_URL=postgresql://user:password@host/dbname

# LangSmith tracing (optional)
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=research-ai-system
LANGCHAIN_TRACING_V2=false

# NOTE: No DATASET_DIR — the production API does NOT read JSONL files.
# NOTE: No HF_TOKEN — model downloads happen offline in the corpus builder.
