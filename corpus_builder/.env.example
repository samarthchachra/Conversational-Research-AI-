# corpus_builder/.env.example
# Offline corpus builder environment variables
# Copy to corpus_builder/.env or set in your shell before running.
# NEVER run the corpus builder inside the Render deployment.

# Qdrant — same instance as production (corpus builder WRITES, production READS)
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# PostgreSQL — same DB as production (tracks ingested papers)
POSTGRES_URL=postgresql://user:password@host/dbname

# Dataset files directory (local path to the *.jsonl files)
# Default: ./research-papers  (relative to where you run the command)
DATASET_DIR=./backend/research-papers

# Qdrant collection name (must match production COLLECTION_NAME)
COLLECTION_NAME=research_papers

# Embedding model — must match the dimension configured in Qdrant (768 for bge-base)
BGE_MODEL=BAAI/bge-base-en-v1.5

# Batch size for document embedding (reduce if you hit OOM)
EMBED_BATCH_SIZE=32

# HuggingFace token (only needed for private/gated models)
HF_TOKEN=
